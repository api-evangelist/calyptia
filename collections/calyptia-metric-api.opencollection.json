        {
          "info": {
            "name": "Project metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud-api.calyptia.com/v1/projects/:projectID/metrics",
            "params": [
              {
                "name": "projectID",
                "value": "",
                "type": "path"
              },
              {
                "name": "start",
                "value": "",
                "type": "query"
              },
              {
                "name": "interval",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Contains an overview of the aggregated metrics for a project.\nIt includes metrics link the amount of records, bytes, and errors per plugin."
        },
